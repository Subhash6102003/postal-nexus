{
  "name": "mailer-service",
  "version": "1.0.0",
  "description": "Production-grade, high-throughput distributed mailing infrastructure",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/index.js --role=api",
    "start:worker": "node dist/index.js --role=worker",
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/index.ts --role=api",
    "dev:worker": "tsx watch src/index.ts --role=worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "tsx src/benchmarks/runner.ts",
    "benchmark:10k": "tsx src/benchmarks/benchmark_10k.ts",
    "benchmark:100k": "tsx src/benchmarks/benchmark_100k.ts",
    "benchmark:1m": "tsx src/benchmarks/benchmark_1m.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
